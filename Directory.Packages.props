<Project>
  <!--
		Central Package Management (NuGet)
		https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management
	-->
  <PropertyGroup>
    <!-- All package versions are managed centrally from this file -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
			TEMPORARY FIX
			Forces centrally defined versions onto transitive dependencies.
			Currently used to keep Xamarin.AndroidX.Core dependencies aligned.
			Remove when the AndroidX dependency graph is aligned upstream.
		-->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ============================================================= -->
    <!-- Avalonia UI                                                   -->
    <!-- Keep all Avalonia packages on the same version when possible. -->
    <!-- ============================================================= -->
    <!-- Core Avalonia framework -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <!-- Fluent theme -->
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <!-- Inter font support -->
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <!-- Diagnostics support -->
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <!-- Desktop platform -->
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <!-- iOS platform -->
    <PackageVersion Include="Avalonia.iOS" Version="12.1.3" />
    <!-- Browser / WebAssembly platform -->
    <PackageVersion Include="Avalonia.Browser" Version="12.1.3" />
    <!-- Android platform -->
    <PackageVersion Include="Avalonia.Android" Version="12.1.3" />
    <!-- ============================================================= -->
    <!-- MVVM / Application infrastructure                             -->
    <!-- ============================================================= -->
    <!-- Community Toolkit for MVVM -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Firebase authentication -->
    <PackageVersion Include="FirebaseAuthentication.net" Version="4.1.0" />
    <!-- Microsoft dependency injection -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <!-- ============================================================= -->
    <!-- UI Icons                                                       -->
    <!-- ============================================================= -->
    <!-- Fluent System Icons for Avalonia -->
    <PackageVersion Include="FluentIcons.Avalonia" Version="2.1.343" />
    <!-- Material Design Icons for Avalonia -->
    <PackageVersion Include="Material.Icons.Avalonia" Version="3.0.2" />
    <!-- ============================================================= -->
    <!-- Entity Framework Core                                         -->
    <!-- ============================================================= -->
    <!-- EF Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!-- SQLite provider -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- In-memory provider (mainly useful for tests) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <!-- ============================================================= -->
    <!-- Android                                                        -->
    <!-- ============================================================= -->
    <!-- AndroidX Splash Screen support -->
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
    <!--
			TEMPORARY FIX

			AndroidX Core is currently pinned manually because the Android
			dependency graph contains mixed Lifecycle versions (2.10.x / 2.11.x).

			Keep these versions synchronized.
			Re-evaluate/remove these pins when Avalonia.Android / AndroidX
			dependencies become fully aligned.
	-->
    <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
    <!-- ============================================================= -->
    <!-- Avalonia extensions                                            -->
    <!-- ============================================================= -->
    <!-- Behaviors for Avalonia -->
    <PackageVersion Include="Avalonia.Xaml.Behaviors" Version="11.3.0.6" />
    <!-- ============================================================= -->
    <!-- Testing                                                        -->
    <!-- ============================================================= -->
    <!-- xUnit -->
    <PackageVersion Include="xunit" Version="2.9.0" />
    <!-- Visual Studio test runner -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- .NET test infrastructure -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Mocking framework -->
    <PackageVersion Include="Moq" Version="4.21.0" />
    <!-- Fluent assertions -->
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <!-- xUnit v3 -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!-- Headless Avalonia platform and renderer for UI tests -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
  </ItemGroup>
</Project>