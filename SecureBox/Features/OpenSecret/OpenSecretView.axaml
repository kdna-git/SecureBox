<UserControl
    x:Class="SecureBox.Views.OpenSecretView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:SecureBox.ViewModels"
    x:DataType="viewmodels:OpenSecretViewModel">

    <StackPanel
        MinWidth="380"
        Background="{DynamicResource Surface}"
        Orientation="Vertical">

        <!--  Header  -->

        <TextBlock
            Margin="0,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="Form Heading"
            Text="{Binding Name}" />

        <!--  Secret  -->

        <Grid
            Margin="12,0"
            ColumnDefinitions="*,*"
            IsVisible="{Binding IsSecret}"
            RowDefinitions="Auto,Auto">

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Margin="8"
                Orientation="Vertical">
                <TextBlock
                    Margin="4,0,0,0"
                    Classes="Form Label"
                    Text="Secret" />
                <Button
                    Classes="Text"
                    Command="{Binding CopyCommand}"
                    CommandParameter="{Binding Secret}"
                    Content="{Binding Secret}"
                    ToolTip.Tip="Copy to clipboard" />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Margin="8"
                IsVisible="{Binding User, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Orientation="Vertical">
                <TextBlock
                    Margin="4,0,0,0"
                    Classes="Form Label"
                    Text="User" />
                <Button
                    Classes="Text"
                    Command="{Binding CopyCommand}"
                    CommandParameter="{Binding User}"
                    Content="{Binding User}"
                    ToolTip.Tip="Copy to clipboard" />
            </StackPanel>

            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Margin="8"
                IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Orientation="Vertical">
                <TextBlock
                    Margin="4,0,0,0"
                    Classes="Form Label"
                    Text="URL" />
                <HyperlinkButton
                    Content="{Binding Url}"
                    IsEnabled="{Binding NavigateUrl, Converter={x:Static ObjectConverters.IsNotNull}}"
                    NavigateUri="{Binding NavigateUrl}" />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Margin="8"
                IsVisible="{Binding Other, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Orientation="Vertical">
                <TextBlock
                    Margin="4,0,0,0"
                    Classes="Form Label"
                    Text="Other data" />
                <TextBlock
                    Margin="4,4,0,0"
                    Classes="Body"
                    Text="{Binding Other}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--  File  -->

        <Grid
            Margin="12,0"
            ColumnDefinitions="*,*"
            IsVisible="{Binding IsFile}">

            <StackPanel
                Grid.Column="0"
                Margin="8"
                Orientation="Vertical">
                <TextBlock
                    Margin="4,0,0,0"
                    Classes="Form Label"
                    Text="Filename" />
                <TextBlock
                    Margin="4,4,0,0"
                    Classes="Body"
                    Text="{Binding Filename}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Margin="8"
                IsVisible="{Binding Other, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Orientation="Vertical">
                <TextBlock
                    Margin="4,0,0,0"
                    Classes="Form Label"
                    Text="Other data" />
                <TextBlock
                    Margin="4,4,0,0"
                    Classes="Body"
                    Text="{Binding Other}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--  Error  -->

        <TextBlock
            Margin="12"
            HorizontalAlignment="Center"
            Classes="Form Label"
            Foreground="{DynamicResource Error}"
            IsVisible="{Binding IsError}"
            Text="This item could not be opened." />

        <TextBlock
            Margin="12,0"
            HorizontalAlignment="Center"
            Classes="Form Label"
            Foreground="{DynamicResource Error}"
            IsVisible="{Binding HasErrorMessage}"
            Text="{Binding ErrorMessage}" />

        <!--  Buttons  -->

        <StackPanel
            Margin="0,12"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                MinWidth="92"
                Margin="0,0,8,0"
                Classes="Form Submit"
                Command="{Binding ExtractCommand}"
                Content="Extract"
                IsVisible="{Binding IsFile}" />
            <Button
                MinWidth="72"
                Classes="Form Cancel"
                Command="{Binding CloseCommand}"
                Content="Close" />
        </StackPanel>
    </StackPanel>
</UserControl>
