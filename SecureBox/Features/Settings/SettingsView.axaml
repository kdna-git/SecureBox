<UserControl
    x:Class="SecureBox.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:viewModels="using:SecureBox.ViewModels"
    x:DataType="viewModels:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.Card">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        </Style>
        <Style Selector="Border.Card Grid > TextBlock.Form.Label">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel
            MaxWidth="560"
            Margin="16"
            HorizontalAlignment="Stretch">

            <!--  Vault  -->

            <Border Classes="Card">
                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="12">
                    <TextBlock
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Classes="Form Heading"
                        Text="Vault" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Classes="Form Label"
                        Text="Location" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Classes="Form Field"
                        IsReadOnly="True"
                        Text="{Binding VaultPath, Mode=OneWay}"
                        ToolTip.Tip="{Binding VaultPath}" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Command="{Binding SelectVaultFolderCommand}"
                        ToolTip.Tip="Change the vault folder">
                        <ic:SymbolIcon FontSize="18" Symbol="Folder" />
                    </Button>

                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Classes="Form Label"
                        Foreground="{DynamicResource Error}"
                        IsVisible="{Binding HasErrorMessage}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!--  Appearance  -->

            <Border Classes="Card">
                <Grid
                    ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="12">
                    <TextBlock
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Classes="Form Heading"
                        Text="Appearance" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Classes="Form Label"
                        Text="Theme" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="160"
                        HorizontalAlignment="Right"
                        ItemsSource="{Binding ThemeOptions}"
                        SelectedItem="{Binding SelectedTheme}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Classes="Form Label"
                        Text="View mode" />
                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="1"
                        MinWidth="160"
                        HorizontalAlignment="Right"
                        ItemsSource="{Binding DataViewModes}"
                        SelectedItem="{Binding DataView}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Classes="Form Label"
                        Text="Mosaic columns" />
                    <NumericUpDown
                        Grid.Row="3"
                        Grid.Column="1"
                        MinWidth="160"
                        HorizontalAlignment="Right"
                        FormatString="0"
                        Increment="1"
                        Maximum="{Binding MaximumMosaicColumns}"
                        Minimum="{Binding MinimumMosaicColumns}"
                        Value="{Binding MosaicColumns}" />
                </Grid>
            </Border>

            <!--  Cloud  -->

            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="Form Heading" Text="Cloud" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="Form Label"
                            Foreground="{DynamicResource Success}"
                            Text="{Binding CloudAccount}" />
                    </Grid>

                    <TextBlock
                        Classes="Caption"
                        Text="Keeps an encrypted copy of your vault in the cloud. Your secrets are never sent decrypted."
                        TextWrapping="Wrap" />

                    <!--  Signed out: email and password  -->
                    <Grid
                        ColumnDefinitions="Auto,*"
                        IsVisible="{Binding IsCloudSignedOut}"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="12">
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Classes="Form Label"
                            Text="Email" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Classes="Form Field"
                            Text="{Binding CloudEmail}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Classes="Form Label"
                            Text="Password" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Classes="Form Field"
                            PasswordChar="•"
                            Text="{Binding CloudPassword}" />

                        <StackPanel
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                MinWidth="86"
                                Classes="Form Cancel"
                                Command="{Binding SignUpCloudCommand}"
                                Content="Sign up" />
                            <Button
                                MinWidth="86"
                                Classes="Form Submit"
                                Command="{Binding SignInCloudCommand}"
                                Content="Sign in" />
                        </StackPanel>
                    </Grid>

                    <!--  Signed in  -->
                    <Button
                        HorizontalAlignment="Right"
                        Classes="Form Cancel"
                        Command="{Binding SignOutCloudCommand}"
                        Content="Sign out"
                        IsVisible="{Binding IsCloudSignedIn}" />

                    <TextBlock
                        Classes="Form Label"
                        Foreground="{DynamicResource Error}"
                        IsVisible="{Binding HasCloudMessage}"
                        Text="{Binding CloudMessage}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
