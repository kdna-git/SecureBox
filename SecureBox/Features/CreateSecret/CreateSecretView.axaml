<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="using:SecureBox.ViewModels"
             x:DataType="viewmodels:CreateSecretViewModel"
             x:Class="SecureBox.Views.CreateSecretView">

    <UserControl.Styles>
        <!--  File and folder pickers take the same space as the text boxes beside them  -->
        <Style Selector="Button.Picker">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="Button.Picker TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Vertical" Background="{DynamicResource Surface}">
        <TextBlock
            Margin="0,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="Form Heading"
            Text="Create Secret" />
        <Border
            Padding="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="12">
            <TabControl Classes="AppTabs">
                <TabItem Header="Text" Classes="AppTab">
                    <Grid MinWidth="380" MinHeight="220" RowDefinitions="*,Auto">
                        <Grid Grid.Row="0" IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" SharedSizeGroup="Group" />
                                <ColumnDefinition Width="*" SharedSizeGroup="SubGroup" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="8"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="4,0,0,0"
                                    Classes="Form Label"
                                    Text="Name" />
                                <TextBox
                                    Classes="Form Field"
                                    Text="{Binding Name, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="8"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="4,0,0,0"
                                    Classes="Form Label"
                                    Text="Secret" />
                                <TextBox
                                    Classes="Form Field"
                                    Text="{Binding Secret, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="8"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="4,0,0,0"
                                    Classes="Form Label"
                                    Text="Folder" />
                                <Button
                                    Classes="Picker"
                                    Command="{Binding SelectDirectoryCommand}"
                                    Content="{Binding SavePath}"
                                    ToolTip.Tip="Choose the folder" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="8"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="4,0,0,0"
                                    Classes="Form Label"
                                    Text="URL" />
                                <TextBox
                                    MinWidth="148"
                                    Classes="Form Field"
                                    Text="{Binding Url}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="8"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="4,0,0,0"
                                    Classes="Form Label"
                                    Text="User" />
                                <TextBox
                                    MinWidth="148"
                                    Classes="Form Field"
                                    Text="{Binding User}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="8"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="4,0,0,0"
                                    Classes="Form Label"
                                    Text="Other data" />
                                <TextBox
                                    MinWidth="148"
                                    Classes="Form Field"
                                    Text="{Binding Other}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            Grid.Row="1"
                            Margin="0,12"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                MinWidth="92"
                                Margin="32,0,8,0"
                                Command="{Binding CreateSecretCommand}"
                                Content="Create"
                                Classes="Form Submit" />
                            <Button
                                MinWidth="72"
                                Margin="8,0,0,0"
                                Command="{Binding CancelCommand}"
                                Content="Cancel"
                                Classes="Form Cancel" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="File" Classes="AppTab">
                    <Grid MinWidth="380" MinHeight="220" RowDefinitions="*,Auto">
                        <Grid Grid.Row="0" IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" SharedSizeGroup="Group" />
                                <ColumnDefinition Width="*" SharedSizeGroup="SubGroup" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="8"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="4,0,0,0"
                                    Classes="Form Label"
                                    Text="File" />
                                <Button
                                    Classes="Picker"
                                    Command="{Binding SelectFileCommand}"
                                    Content="{Binding FileButtonText}"
                                    ToolTip.Tip="Choose the file to encrypt" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="8"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="4,0,0,0"
                                    Classes="Form Label"
                                    Text="Name" />
                                <TextBox
                                    Classes="Form Field"
                                    Text="{Binding Name, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="8"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="4,0,0,0"
                                    Classes="Form Label"
                                    Text="Folder" />
                                <Button
                                    Classes="Picker"
                                    Command="{Binding SelectDirectoryCommand}"
                                    Content="{Binding SavePath}"
                                    ToolTip.Tip="Choose the folder" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="8"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="4,0,0,0"
                                    Classes="Form Label"
                                    Text="Other data" />
                                <TextBox
                                    MinWidth="148"
                                    Classes="Form Field"
                                    Text="{Binding Other}" />
                            </StackPanel>

                            <Grid
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="Form Label"
                                    Text="Compress" />
                                <CheckBox
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Compress}" />
                            </Grid>

                            <Grid
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="Form Label"
                                    Text="Delete origin file" />
                                <CheckBox
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Delete}" />
                            </Grid>
                        </Grid>

                        <StackPanel
                            Grid.Row="1"
                            Margin="0,12"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                MinWidth="92"
                                Margin="32,0,8,0"
                                Command="{Binding CreateFileCommand}"
                                Content="Create"
                                Classes="Form Submit" />
                            <Button
                                MinWidth="72"
                                Margin="8,0,0,0"
                                Command="{Binding CancelCommand}"
                                Content="Cancel"
                                Classes="Form Cancel" />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <TextBlock
            Margin="0,0,0,12"
            HorizontalAlignment="Center"
            Classes="Form Label"
            Foreground="{DynamicResource Error}"
            IsVisible="{Binding HasErrorMessage}"
            Text="{Binding ErrorMessage}" />
    </StackPanel>
</UserControl>
