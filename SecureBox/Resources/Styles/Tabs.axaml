<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tab item styled as an application tab with custom template and interaction states. -->
    <Style Selector="TabItem.AppTab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Width" Value="100" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border
                        Name="PART_Border"
                        Margin="{TemplateBinding Margin}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4" />
                    <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Highlight the tab when hovered. -->
    <Style Selector="TabItem.AppTab:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource TabHover}" />
    </Style>

    <!-- Highlight the selected tab. -->
    <Style Selector="TabItem.AppTab:selected /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource SelectedTab}" />
    </Style>

    <Style Selector="TabItem.AppTab:selected">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    </Style>

    <!-- Tab control styled as an application tab strip with a content area. -->
    <Style Selector="TabControl.AppTabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="50,*">
                    <ItemsPresenter
                        Name="PART_ItemsPresenter"
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    <Border
                        Grid.Row="1"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            Name="PART_SelectedContentHost"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

</Styles>
